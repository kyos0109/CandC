{
  "name": "candc",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:isolated": "node scripts/build-isolated.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:install": "node scripts/verify-install.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "doctor": "tsx src/doctor.ts",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "export:public": "node scripts/export-public.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "exceljs": "^4.4.0",
    "fastify": "5.12.5",
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yauzl": "^3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  },
  "license": "MIT",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "mammoth": {
      "argparse": "^2.0.1"
    }
  }
}
